rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /listeners/{id} {
      allow read: if true;

      // リスナー本人による登録。名前・よみがなの形式を制限する。
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ["name","kana","active","selfRegistered","createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.kana is string
        && request.resource.data.kana.size() > 0
        && request.resource.data.kana.size() <= 30
        && request.resource.data.active == true;

      allow update, delete: if signedIn();
    }

    match /attendance/{id} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/attendance/$(id));
      allow update, delete: if signedIn();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /lfr/{id} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
